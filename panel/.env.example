# Copy to .env and edit. Never commit the real .env file.
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
# Web panel port on the host
PANEL_PORT=8090
# Time zone for timestamps in logs (the web page uses the browser's time zone)
TZ=Europe/Istanbul
# Optional: device address used for the "settings page" link until the sensor reports its IP
CIHAZ_ADRESLERI=toprak-sensoru=192.168.1.50
